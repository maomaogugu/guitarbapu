import sys; sys.path.insert(0,'.')
import numpy as np
from src.audio.loader import load_audio
from src.audio.librosa_compat import import_librosa
a = load_audio('/Users/youzi/Downloads/晴天吉他谱-指弹谱-g调-虫虫吉他.mp3')
librosa = import_librosa()
w = np.asarray(a.waveform, dtype=np.float32)
if w.ndim==2: w=w.mean(axis=1)
# harmonic-to-noise, zero-crossing rate, spectral centroid to detect speech vs music
hop=512
zcr = librosa.feature.zero_crossing_rate(w, hop_length=hop)[0]
centroid = librosa.feature.spectral_centroid(y=w, sr=a.sample_rate, hop_length=hop)[0]
times = librosa.frames_to_time(np.arange(len(zcr)), sr=a.sample_rate, hop_length=hop)
# print every 5s: mean zcr, centroid
for t in range(0, 123, 5):
    mask = (times>=t)&(times<t+5)
    print(f'{t:4d}-{t+5:3d}s zcr={zcr[mask].mean():.4f} centroid={centroid[mask].mean():6.0f}Hz')
