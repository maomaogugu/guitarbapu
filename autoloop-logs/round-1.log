import sys; sys.path.insert(0,'.')
import numpy as np
from src.audio.loader import load_audio
a = load_audio('/Users/youzi/Downloads/晴天吉他谱-指弹谱-g调-虫虫吉他.mp3')
w = np.asarray(a.waveform).mean(axis=1) if np.ndim(a.waveform)==2 else np.asarray(a.waveform)
sr = a.sample_rate
# RMS in 0.5s windows
hop = sr//2
n = len(w)//hop
rms = []
for i in range(n):
    seg = w[i*hop:(i+1)*hop]
    rms.append(float(np.sqrt(np.mean(seg**2))))
rms = np.array(rms)
print('duration', a.duration, 'nwin', n)
# print times with high rms
for i in range(n):
    if rms[i] > 0.01:
        print(f'{i*0.5:7.1f}s rms={rms[i]:.4f}')
